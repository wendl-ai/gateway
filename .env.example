# ============================================================================
# Wendl gateway environment — copy to .env and fill in.
# ============================================================================

# ---- Cloud model providers -------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: OpenRouter unlocks Gemini Flash / OSS models as alternative tiers
OPENROUTER_API_KEY=

# ---- Gateway ----------------------------------------------------------------
# Administers the gateway + mints virtual keys. Make it long and random.
LITELLM_MASTER_KEY=sk-claw-CHANGE-ME-to-a-long-random-string

# WENDL_GATEWAY_PORT=4000
# WENDL_GATEWAY_HOST=127.0.0.1               # loopback only (secure default). For a
#                                            # multi-box setup set your Tailscale IP
#                                            # (100.x.y.z) — reachable on the tailnet only.
# WENDL_GATEWAY_DATA=data                    # spend log + keystore location
# WENDL_GATEWAY_RETRIES=2

# ---- Repeat brake (off by default) ------------------------------------------
# A budget cap stops spending; this stops LOOPING — the same question asked over
# and over inside one space. It refuses calls that would otherwise be served, so
# it stays off until you set a limit. Scope is the x-wendl-space tag when present,
# else the virtual key; untagged master traffic is exempt (that's evals).
# WENDL_REPEAT_LIMIT=5                       # identical calls per window. 0 = off
# WENDL_REPEAT_WINDOW_MS=60000

# ---- Per-alias budgets (used by `npm run bootstrap`) -----------------------
TEAM_MONTHLY_BUDGET=50      # interactive team agent
OPS_MONTHLY_BUDGET=5        # cron/automation agent (should rarely touch cloud)

# ---- Ollama (only needed for tier-local-* models) ---------------------------
OLLAMA_BASE=http://localhost:11434/v1
